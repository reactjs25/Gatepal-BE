# -----------------------------
# App
# -----------------------------
NODE_ENV=development
PORT=3003

# Comma-separated list of allowed frontend origins
# Example: http://localhost:3000,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# -----------------------------
# Database
# -----------------------------
MONGO_URI=mongodb://127.0.0.1:27017/gatepal
DB_ALERT_DEBOUNCE_MS=900000

# -----------------------------
# Auth / Security
# -----------------------------
JWT_SECRET=replace-with-strong-secret
USER_JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
OTP_TTL_IN_MS=300000
PASSWORD_RESET_TOKEN_TTL=3600000

# -----------------------------
# Password Reset / Frontend URLs
# -----------------------------
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SOCIETY_ADMIN_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# -----------------------------
# Email (SMTP)
# -----------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
SMTP_FROM=no-reply@example.com

# Alert recipients (comma-separated)
ALERT_EMAILS=alerts@example.com
SUPER_ADMIN_ALERT_EMAIL=admin@example.com

# -----------------------------
# Firebase
# -----------------------------
# Full JSON string of service account credentials (single-line escaped JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# -----------------------------
# AWS S3
# -----------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name

# -----------------------------
# Guards Log Report Cron (optional)
# -----------------------------
# true/false
GUARDS_LOG_REPORT_CRON_ENABLED=false
# Daily at midnight
GUARDS_LOG_REPORT_CRON_SCHEDULE=0 0 * * *
GUARDS_LOG_REPORT_CRON_TIMEZONE=Asia/Kolkata
# Number of societies processed in parallel per batch
GUARDS_LOG_REPORT_BATCH_SIZE=10

# -----------------------------
# Visitor Log Report Cron (optional)
# -----------------------------
# true/false
VISITOR_LOG_REPORT_CRON_ENABLED=false
# Daily at midnight
VISITOR_LOG_REPORT_CRON_SCHEDULE=0 0 * * *
VISITOR_LOG_REPORT_CRON_TIMEZONE=Asia/Kolkata
# Number of societies processed in parallel per batch
VISITOR_LOG_REPORT_BATCH_SIZE=10

# -----------------------------
# Unit List Report Cron (optional)
# -----------------------------
# true/false
UNIT_LIST_REPORT_CRON_ENABLED=false
# Daily at midnight
UNIT_LIST_REPORT_CRON_SCHEDULE=0 0 * * *
UNIT_LIST_REPORT_CRON_TIMEZONE=Asia/Kolkata
# Number of societies processed in parallel per batch
UNIT_LIST_REPORT_BATCH_SIZE=10

# -----------------------------
# Resident Report Cron (optional)
# -----------------------------
# true/false
RESIDENT_REPORT_CRON_ENABLED=false
# Daily at midnight
RESIDENT_REPORT_CRON_SCHEDULE=0 0 * * *
RESIDENT_REPORT_CRON_TIMEZONE=Asia/Kolkata
# Number of societies processed in parallel per batch
RESIDENT_REPORT_BATCH_SIZE=10

# -----------------------------
# Twilio (optional)
# -----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
